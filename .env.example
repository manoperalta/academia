# Copie para .env e ajuste. NUNCA versione o .env real.
DJANGO_ENV=prod
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_ALLOWED_HOSTS=academia.safestack.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://academia.safestack.com.br

# Banco (12-factor). Em producao usa a Postgres do docker-compose.yml (servico "db").
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://academia:troque-esta-senha@db:5432/academia

# E-mail (producao usa SMTP; sem isto o envio vai para o log do container)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@academia.safestack.com.br
