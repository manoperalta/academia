# Copie para .env e ajuste. NUNCA versione o .env real.
DJANGO_ENV=dev
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=1
DJANGO_DEBUG_TOKEN=token-para-ver-traceback-no-laboratorio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,academia.safestack.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://academia.safestack.com.br

# Banco (12-factor). Sem DATABASE_URL o projeto usa SQLite local.
DATABASE_URL=postgres://academia:academia@db:5432/academia_dev

# E-mail (producao usa SMTP; em dev vai para o console)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@academia.com
